{
  "name": "studcorp-carte-mentale-worker",
  "private": true,
  "version": "1.0.0",
  "description": "Cloudflare Worker pour la synchronisation multi-appareils de la carte mentale STUDCORP et le proxy IA optionnel.",
  "scripts": {
    "login": "wrangler login",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "secret:origin": "wrangler secret put ALLOWED_ORIGIN",
    "secret:openai": "wrangler secret put OPENAI_API_KEY",
    "secret:model": "wrangler secret put OPENAI_MODEL"
  },
  "devDependencies": {
    "wrangler": "4.156.0"
  }
}
